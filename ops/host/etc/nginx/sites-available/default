map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

upstream django {
    server 127.0.0.1:8000;
}
server {
        server_name aledb.org www.aledb.org 4.231.249.59;
    location / {
        proxy_pass http://127.0.0.1:8000;

        # Pass the visitor's real address to the app. Without these, Django and
        # daphne only see nginx's own address (the Docker bridge, 172.18.0.1).
        # $remote_addr OVERWRITES any X-Forwarded-For a client sent, so the value
        # cannot be spoofed (daphne --proxy-headers reads the FIRST entry). This is
        # correct because nginx is the only proxy in front of the app. Logging only;
        # nothing in the app uses these for access control. Remove to revert.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;

        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 3600;
        proxy_send_timeout 3600;
    }
    location /aledata {
        alias /data/aledata;
        autoindex off;
        satisfy any;
    }
    location /static {
        alias /var/www/aledb/static;
    }


    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/aledb.org/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/aledb.org/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

    location /ws/ {
        proxy_pass http://django;
         # this magic is needed for WebSocket
        proxy_http_version  1.1;
        proxy_set_header    Upgrade $http_upgrade;
        proxy_set_header    Connection $connection_upgrade;
        proxy_set_header    Host $http_host;
        proxy_set_header    X-Real-IP $remote_addr;
        proxy_redirect off;
        # $remote_addr (not $proxy_add_x_forwarded_for): overwrite, so clients
        # cannot spoof the address; nginx is the only proxy here. See location /.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $server_name;
        proxy_set_header X-Forwarded-Proto  $scheme;
    }

}
server {
    if ($host = 4.231.249.59) {
        return 301 https://$host$request_uri;
    }
    if ($host = www.aledb.org) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    if ($host = aledb.org) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


        listen 80;
        server_name aledb.org www.aledb.org; 
    return 404; # managed by Certbot

}


