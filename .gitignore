# Operator-local audit working docs. Contain live credential values + detailed
# operational notes from the pre-publish security audit. The publish-safe
# versions of this content live as docs/operations/audit_summary.md (the
# inventory + outcome) and docs/operations/git_history_scrub.md (the runbook).
/audit_local/

# Operator-local scratch/working notes. Not for publication — kept out of git
# deliberately (may reference live infra, credentials, or internal ops detail).
/docs/tmp/

# Vendored deps for scripts/weekly_traffic_report.py (installed with
# `pip install --target scripts/_vendor geoip2fast`); not for publication.
/scripts/_vendor/

# Claude Code local (per-machine) settings: SessionStart hook that surfaces the
# weekly traffic report flags. Paths are server-specific; not for publication.
/.claude/settings.local.json

# Host config mirror: the journald drop-in must be tracked despite the *.conf rule above.
!/ops/host/etc/systemd/journald.conf.d/aledb.conf
